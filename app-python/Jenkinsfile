pipeline {
    agent any
    stages {
        stage('Test') {
            agent {
                docker { image 'python:3.12-slim' }
            }
            steps {
                dir('app-python') {
                    sh '''
                       python3 -m venv venv
                       source venv/bin/activate
                       pip3 install -r requirements-dev.txt
                       pytest
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Desplegando en el clúster de Kubernetes...'
                sh 'kubectl apply -f k8s/dev/app-python-deployment.yaml'
            }
        }
    }
}
